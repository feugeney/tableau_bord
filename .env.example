# ---- Django
DJANGO_SECRET_KEY=a-generer-openssl-rand-hex-32
DJANGO_ALLOWED_HOSTS=tdb.mefb.gov.gn,localhost
CSRF_TRUSTED_ORIGINS=https://tdb.mefb.gov.gn
DJANGO_SECURE_SSL_REDIRECT=true
LOG_LEVEL=INFO

# ---- Entrepôt PostgreSQL 16
POSTGRES_DB=tdb
POSTGRES_USER=tdb
POSTGRES_PASSWORD=a-changer

# ---- Redis (cache 15 min + Celery). Vide en développement = cache mémoire local.
REDIS_URL=redis://redis:6379/0

# ---- Sources externes : comptes en LECTURE SEULE uniquement
# Chaîne Dépense : réplique ou vues dédiées ; jamais la production aux heures ouvrées.
CHAINE_DEPENSE_ORACLE_DSN=
CHAINE_DEPENSE_ORACLE_USER=
CHAINE_DEPENSE_ORACLE_PASSWORD=
# SICOM et SYSOP (PostgreSQL, DNSI) : postgresql://lecteur:***@hote:5432/base
SICOM_DATABASE_URL=
SYSOP_DATABASE_URL=
# Telemo (API REST en lecture) : adresse de base et jeton (en-tête Authorization: Bearer)
TELEMO_API_URL=
TELEMO_API_TOKEN=

# ---- RabbitMQ (AMQP 0.9.1) : tâches planifiées et événements publiés aux partenaires
RABBITMQ_USER=tdb
RABBITMQ_PASSWORD=a-changer

# ---- Dépôt de fichiers des partenaires (SFTP, clés publiques dans sftp/cles/)
SFTP_PORT=2222
DEPOT_RELEVE_MINUTES=5
DEPOT_STABILITE_SECONDES=60

# ---- Imports
IMPORT_TAILLE_MAX=104857600

# ---- nginx
HTTP_PORT=80
HTTPS_PORT=443
