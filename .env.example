# ---- Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
DJANGO_SECURE_SSL_REDIRECT=false
SERVIR_FRONTEND_LOCAL=true
LOG_LEVEL=INFO
# Test sur un seul exercice (vide = tous les exercices).
TDB_EXERCICE_TEST=

# ---- Base PostgreSQL native ; Installer.cmd genere les secrets manquants
POSTGRES_DB=tdb
POSTGRES_USER=tdb
POSTGRES_PASSWORD=
POSTGRES_HOST=::1
POSTGRES_PORT=55432

# ---- Redis (cache 15 min + Celery). Vide en développement = cache mémoire local.
REDIS_URL=
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
EVENEMENTS_AMQP_URL=

# ---- Sources externes : comptes en LECTURE SEULE uniquement
# Chaîne Dépense : réplique ou vues dédiées ; jamais la production aux heures ouvrées.
CHAINE_DEPENSE_ORACLE_DSN=
CHAINE_DEPENSE_ORACLE_USER=
CHAINE_DEPENSE_ORACLE_PASSWORD=
# Oracle 11.2 : mode Thick avec Instant Client 19 de même architecture que Python.
CHAINE_DEPENSE_ORACLE_THICK=false
CHAINE_DEPENSE_ORACLE_CLIENT_LIB_DIR=
CHAINE_DEPENSE_ORACLE_CONNECT_TIMEOUT=10
CHAINE_DEPENSE_ORACLE_CALL_TIMEOUT_MS=30000
# SICOM et SYSOP (PostgreSQL, DNSI) : postgresql://lecteur:***@hote:5432/base
SICOM_DATABASE_URL=
SYSOP_DATABASE_URL=
# Telemo (API REST en lecture) : adresse de base et jeton (en-tête Authorization: Bearer)
TELEMO_API_URL=
TELEMO_API_TOKEN=

# ---- Depot local de fichiers (aucun serveur SFTP requis)
DEPOT_RELEVE_MINUTES=5
DEPOT_STABILITE_SECONDES=60

# ---- Imports
IMPORT_TAILLE_MAX=104857600


# ---- Courriels des alertes (arbitrages de la Ministre et relance a 48 h)
# Sans EMAIL_HOST, les courriels sont ecrits dans le journal de l'API au lieu d'etre envoyes.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Tableau de bord <ne-pas-repondre@localhost>
# Adresse de l'application dans les liens des courriels
TDB_URL_PUBLIQUE=http://localhost:5173

# ---- SIDOF-ENTREPOT (API en lecture) : lignes budgetaires de la Chaine Depense
# Une cle par application, transmise dans l'en-tete X-API-Key (a demander a la DNSI).
SIDOF_API_URL=https://sidof-api.mefb.gov.gn
SIDOF_API_KEY=
